# Jobs Agent Environment Variables — copy this file to .env and fill in real values.
# .env is gitignored; never commit your real keys.

# Supabase (used by the Python agent)
SUPABASE_URL="https://your-project.supabase.co"
# Must be the service_role (secret) key, not the anon/publishable key — the agent
# needs to bypass RLS to write companies/jobs/etc. Find it under Project Settings > API.
SUPABASE_KEY="your-service-role-secret-key"

# DeepSeek AI (used by the Python agent for job relevance + company review)
DEEPSEEK_API_KEY="your-deepseek-api-key"

# SMTP for email notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_USE_STARTTLS="true"

# Structured discovery (defaults shown)
SIMPLIFY_SOURCE_URL="https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/.github/scripts/listings.json"
# Optional comma-separated feed terms. Blank means all active, visible listings.
SIMPLIFY_TERMS=""
SIMPLIFY_BATCH_SIZE="100"
SIMPLIFY_HTTP_TIMEOUT="30"

# Matching and notification cost controls
FEED_EVALUATION_LOOKBACK_DAYS="14"
MAX_NEW_JOB_EVALUATIONS="200"
JOB_EVALUATION_WORKERS="8"
NOTIFY_MATCH_THRESHOLD="70"
NOTIFICATION_LOOKBACK_DAYS="2"
NOTIFICATION_MIN_INTERVAL_MINUTES="240"
NOTIFICATION_MAX_MATCHES="50"

# Optional read-only Gmail ingestion. The structured feed works without these.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_OWNER_USER_ID=""
GMAIL_INGEST_QUERY="from:noreply@swelist.com newer_than:7d"
GMAIL_MAX_RESULTS="50"
GMAIL_STORE_RAW_BODY="false"

# Private/local application runner paths
APPLICATION_RESUME_PATH="/absolute/private/path/resume.pdf"
APPLICATION_BROWSER_PROFILE_DIR="/absolute/private/path/jobs-agent-browser"
APPLICATION_ARTIFACT_DIR="/absolute/private/path/jobs-agent-artifacts"

# Live final submission is disabled when blank. Read the safety documentation
# before ever setting the exact enable phrase locally. Never enable it in routine CI.
APPLICATION_LIVE_SUBMIT_ENABLED=""
